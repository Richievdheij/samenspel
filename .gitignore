# The local SQLite database and its journals are state, not source.
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# Playwright writes a screenshot next to the test when a browser assertion fails.
# It is a debugging artefact of one run, not source.
/tests/Browser/Screenshots

# Laravel Boost skill files are GENERATED, like vendor/ and node_modules/.
# boost.json records which ones; regenerate them with:
#     php artisan boost:install --skills
# They are not tracked because they are vendored documentation that carries
# illustrative fake credentials, and committing them put a `sk_live_...` example
# into the history that the secret scanner then reported forever.
/.claude/skills

# JetBrains Junie skill copies, written by boost:install alongside .claude/skills.
# Nobody here uses Junie and they duplicate that directory file for file.
/.junie
