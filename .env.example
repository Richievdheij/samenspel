# Local environment template. `make env` renders .env from this file.
#
# Two rules this file lives by:
#   1. Never put a comment after a value. This file is both sourced as shell and
#      read by tooling; a trailing `# ...` is folded into the value and you get a
#      URI with a sentence glued to it. Explanations go on the lines above.
#   2. Every published port is a variable. A literal port somewhere else answers
#      for the wrong thing the moment a colleague moves it.

# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Laravel Starter Template"
APP_ENV=local
# Left empty on purpose. `make env` runs `php artisan key:generate` once, when
# this is empty. Shipping an example value here would defeat that permanently:
# only an empty value is ever filled, so a fresh clone would inherit the example
# as though somebody had chosen it.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# ─── Locale ─────────────────────────────────────────────────────────────────
# Dutch interface, English fallback, Amsterdam time.
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL
APP_TIMEZONE=Europe/Amsterdam

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite locally: no server to start, and a fresh clone works immediately.
# The MySQL credentials below are inert while DB_CONNECTION is sqlite. They are
# declared anyway so `make integration` works against a local MySQL without
# anyone having to invent key names, and so this template and the production one
# declare the same keys.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=samenspel
DB_USERNAME=root
DB_PASSWORD=

# ─── Session, cache, queue and files ────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Mail ───────────────────────────────────────────────────────────────────
# `log` writes mail to storage/logs instead of sending it.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Frontend ───────────────────────────────────────────────────────────────
# Vite silently takes 5174 when 5173 is busy, and you then load a page served by
# one Vite against a manifest written by another. `make status` reports the real
# port; this is the one it expects.
VITE_PORT=5173
